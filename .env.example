# Puerto del servidor
PORT=3000

# Llave para cifrar las credenciales de Dropi de cada dropshipper.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Ruta del archivo de base de datos SQLite
DATABASE_PATH=./data/avirofy.db

# "mock" usa un Dropi falso con pedidos de ejemplo (código de verificación 123456).
# "live" se conecta a Dropi de verdad.
DROPI_MODE=mock

# Conexión a Dropi (modo live). Las rutas marcadas POR CONFIRMAR se ajustan
# cuando confirmemos cómo lo hace Dropi México.
DROPI_API_BASE=https://api.dropi.co/api
DROPI_WHITE_BRAND_ID=
DROPI_PATH_LOGIN=/login
DROPI_PATH_VERIFY=/login/verify
DROPI_PATH_ORDERS=/orders/myorders
DROPI_PATH_CANCEL=/orders/myorders/:id

# Cada cuántos minutos revisar el Dropi de todos los dropshippers (0 = apagado)
SYNC_EVERY_MINUTES=15

# Tarifa por entrega en MXN
TARIFA_MXN=170
